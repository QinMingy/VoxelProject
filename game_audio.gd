extends Node

const AUDIO_ROOT := "res://assets/audio/"
const BUS_NAME := "MoonSFX"
const MAX_VOICES := 16
const BASE_VOLUME_DB := -16.0
# Files are generated by tools/generate_audio.py, without external sample assets.
const EVENTS := {
	&"dig": {"files": ["dig_1", "dig_2", "dig_3"], "db": -5.0, "cooldown": 0.055},
	&"footstep": {"files": ["footstep_1", "footstep_2", "footstep_3", "footstep_4"], "db": -5.0, "cooldown": 0.12},
	&"jump": {"files": ["jump"], "db": -3.0, "cooldown": 0.20},
	&"land": {"files": ["land"], "db": -1.0, "cooldown": 0.20},
	&"crystal_exposed": {"files": ["crystal_exposed"], "db": -1.0, "cooldown": 0.40, "priority": 2},
	&"crystal_loose": {"files": ["crystal_loose"], "db": 1.0, "cooldown": 0.35, "priority": 2},
	&"crystal_pickup": {"files": ["crystal_pickup"], "db": 1.0, "cooldown": 0.10, "priority": 2},
	&"crystal_drop": {"files": ["crystal_drop"], "db": -1.0, "cooldown": 0.12},
	&"oxygen_pickup": {"files": ["oxygen_pickup_1", "oxygen_pickup_2", "oxygen_pickup_3"], "db": -8.0, "cooldown": 0.08},
	&"oxygen_low": {"files": ["oxygen_low"], "db": -3.0, "cooldown": 3.0, "priority": 3},
	&"oxygen_critical": {"files": ["oxygen_critical"], "db": -1.0, "cooldown": 1.6, "priority": 3},
	&"boundary_warning": {"files": ["boundary_warning"], "db": -4.0, "cooldown": 2.0, "priority": 3},
	&"radar_ping": {"files": ["radar_ping"], "db": -8.0, "cooldown": 1.8},
	&"deploy": {"files": ["deploy"], "db": 0.0, "cooldown": 0.50, "priority": 3},
	&"safe_extract": {"files": ["safe_extract"], "db": 1.0, "cooldown": 0.50, "priority": 3},
	&"rescue": {"files": ["rescue"], "db": 0.0, "cooldown": 0.50, "priority": 3},
	&"ui_click": {"files": ["ui_click"], "db": -7.0, "cooldown": 0.035},
	&"menu_open": {"files": ["menu_open"], "db": -5.0, "cooldown": 0.08},
	&"menu_close": {"files": ["menu_close"], "db": -5.0, "cooldown": 0.08},
	&"rotate": {"files": ["rotate"], "db": -6.0, "cooldown": 0.045},
	&"error": {"files": ["error"], "db": -4.0, "cooldown": 0.22},
	&"purchase": {"files": ["purchase"], "db": 0.0, "cooldown": 0.12, "priority": 2},
}
const UI_EVENTS := [&"ui_click", &"menu_open", &"menu_close", &"rotate", &"error", &"purchase", &"deploy", &"safe_extract", &"rescue"]

static var _bus_users := 0
static var _created_bus := false

var muted := false
var _bank: Dictionary = {}
var _voices: Array[AudioStreamPlayer] = []
var _voice_started: Array[int] = []
var _voice_priority: Array[int] = []
var _next_allowed: Dictionary = {}
var _variants: Dictionary = {}
var _drill_player: AudioStreamPlayer
var _drilling := false
var _walking := false
var _walking_speed := 1.0
var _step_clock := 0.0
var _drill_level := 0.0
var _focused := true
var _ui_roots: Array[WeakRef] = []

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus()
	for event: StringName in EVENTS:
		var streams: Array[AudioStreamWAV] = []
		for file_name: String in EVENTS[event].files:
			var stream := load(AUDIO_ROOT + file_name + ".wav") as AudioStreamWAV
			if stream != null:
				streams.append(stream)
		_bank[event] = streams
	for index in range(MAX_VOICES):
		_voices.append(_new_player("Voice%d" % index))
		_voice_started.append(0)
		_voice_priority.append(0)
	_drill_player = _new_player("DrillLoop")
	var loop := load(AUDIO_ROOT + "drill_loop.wav") as AudioStreamWAV
	if loop != null:
		# Imported WAV may use QOA compression, so bytes are not PCM frames.
		var frames := roundi(loop.get_length() * loop.mix_rate)
		loop.loop_mode = AudioStreamWAV.LOOP_FORWARD
		loop.loop_begin = 0
		loop.loop_end = frames
		_drill_player.stream = loop
	_drill_player.volume_db = -80.0

func _ensure_bus() -> void:
	_bus_users += 1
	if AudioServer.get_bus_index(BUS_NAME) >= 0:
		return
	AudioServer.add_bus()
	var index := AudioServer.bus_count - 1
	AudioServer.set_bus_name(index, BUS_NAME)
	AudioServer.set_bus_send(index, "Master")
	AudioServer.set_bus_volume_db(index, -3.0)
	var limiter := AudioEffectLimiter.new()
	limiter.threshold_db = -4.0
	limiter.ceiling_db = -1.0
	AudioServer.add_bus_effect(index, limiter)
	_created_bus = true

func _exit_tree() -> void:
	_stop_all()
	if is_instance_valid(_drill_player):
		_drill_player.stream = null
	for player in _voices:
		if is_instance_valid(player):
			player.stream = null
	_bank.clear()
	_bus_users -= 1
	if _bus_users == 0 and _created_bus:
		var index := AudioServer.get_bus_index(BUS_NAME)
		if index >= 0:
			AudioServer.remove_bus(index)
		_created_bus = false

func _new_player(node_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = node_name
	player.bus = BUS_NAME
	player.max_polyphony = 1
	player.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(player)
	return player

func play_event(event: StringName, gain: float = 1.0) -> void:
	if muted or not _focused or gain <= 0.0 or not _bank.has(event):
		return
	if get_tree().paused and event not in UI_EVENTS:
		return
	var now := Time.get_ticks_msec()
	if now < int(_next_allowed.get(event, 0)):
		return
	var streams: Array = _bank[event]
	if streams.is_empty():
		return
	var settings: Dictionary = EVENTS[event]
	var priority := int(settings.get("priority", 1))
	var slot := _voice_slot(priority)
	if slot < 0:
		return
	var variant := int(_variants.get(event, 0))
	_variants[event] = variant + 1
	_next_allowed[event] = now + roundi(float(settings.get("cooldown", 0.0)) * 1000.0)
	var player := _voices[slot]
	player.stop()
	player.stream = streams[variant % streams.size()]
	player.volume_db = BASE_VOLUME_DB + float(settings.get("db", 0.0)) + linear_to_db(clampf(gain, 0.01, 1.5))
	# Small deterministic variation preserves cues without a repeated identical click.
	player.pitch_scale = [0.98, 1.0, 1.025, 0.99][variant % 4]
	_voice_started[slot] = now
	_voice_priority[slot] = priority
	player.play()

func _voice_slot(priority: int) -> int:
	var candidate := 0
	for index in range(_voices.size()):
		if not _voices[index].playing:
			return index
		if _voice_priority[index] < _voice_priority[candidate] or (_voice_priority[index] == _voice_priority[candidate] and _voice_started[index] < _voice_started[candidate]):
			candidate = index
	return candidate if _voice_priority[candidate] <= priority else -1

func set_drilling(active: bool, speed: float = 1.0) -> void:
	_drilling = active and _gameplay_allowed()
	if _drill_player == null:
		return
	_drill_player.pitch_scale = clampf(0.95 * sqrt(maxf(speed, 0.1)), 0.8, 1.55)
	if _drilling and not _drill_player.playing:
		_drill_player.play()

func set_walking(active: bool, speed: float = 1.0) -> void:
	var starting := not _walking
	_walking = active and _gameplay_allowed()
	_walking_speed = clampf(speed, 0.5, 2.2)
	if starting and _walking:
		_step_clock = 0.04

func _gameplay_allowed() -> bool:
	return is_inside_tree() and not muted and _focused and not get_tree().paused

func set_muted(enabled: bool) -> void:
	muted = enabled
	if enabled:
		_stop_all()

func stop_gameplay_loops() -> void:
	_drilling = false
	_walking = false
	_drill_level = 0.0
	_step_clock = 0.0
	if is_instance_valid(_drill_player):
		_drill_player.stop()
		_drill_player.volume_db = -80.0

func _stop_all() -> void:
	stop_gameplay_loops()
	for player in _voices:
		if is_instance_valid(player):
			player.stop()

func _process(delta: float) -> void:
	if not _gameplay_allowed():
		stop_gameplay_loops()
		return
	_drill_level = move_toward(_drill_level, 1.0 if _drilling else 0.0, delta * 18.0)
	if _drill_player != null:
		_drill_player.volume_db = -21.0 + linear_to_db(maxf(_drill_level, 0.001))
		if _drill_level <= 0.0 and _drill_player.playing:
			_drill_player.stop()
	if _walking:
		_step_clock -= delta
		if _step_clock <= 0.0:
			play_event(&"footstep")
			_step_clock = 0.40 / _walking_speed

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
		_focused = false
		_stop_all()
	elif what == NOTIFICATION_APPLICATION_FOCUS_IN:
		_focused = true

func bind_ui(ui_root: Node) -> void:
	for entry in _ui_roots:
		if entry.get_ref() == ui_root:
			return
	_ui_roots.append(weakref(ui_root))
	_bind_buttons(ui_root)
	var callback := Callable(self, "_on_tree_node_added")
	if not get_tree().node_added.is_connected(callback):
		get_tree().node_added.connect(callback)

func _bind_buttons(node: Node) -> void:
	if node is BaseButton:
		var callback := Callable(self, "_on_button_pressed")
		if not node.pressed.is_connected(callback):
			node.pressed.connect(callback)
	for child in node.get_children():
		_bind_buttons(child)

func _on_tree_node_added(node: Node) -> void:
	if not node is BaseButton:
		return
	for entry in _ui_roots:
		var ui_root: Node = entry.get_ref()
		if is_instance_valid(ui_root) and ui_root.is_ancestor_of(node):
			_bind_buttons(node)
			return

func _on_button_pressed() -> void:
	play_event(&"ui_click")
